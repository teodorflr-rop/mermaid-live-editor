# Mermaid Live Editor Environment Variables

# Set to 'true' to enable view-only mode (disables all editing features)
# Useful for Docker deployments where you want to provide read-only diagram viewing
MERMAID_VIEW_ONLY_MODE=false

# Other existing environment variables
MERMAID_ANALYTICS_URL=
MERMAID_DOMAIN=
MERMAID_IS_ENABLED_MERMAID_CHART_LINKS=false
MERMAID_KROKI_RENDERER_URL=
MERMAID_RENDERER_URL=
